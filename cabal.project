packages: .
with-compiler: ghc-9.10.3
tests: True
-- same plan locally and in CI
index-state: 2026-10-10T15:43:10Z

-- stale upper bounds; both build fine on 9.10
allow-newer:
  , calamity:typerep-map
  , aeson-optics:base

-- data-default 0.8 has its own Default class, but the tls 2.0 stack calamity
-- resolves to here still uses data-default-class 0.1's
constraints: data-default <0.8
