cabal-version:      3.0
name:               bad-player
version:            0.1.0.0
synopsis:           Discord bot that keeps a channel YouTube-links-only
license:            NONE
build-type:         Simple
tested-with:        GHC ==9.10.3 || ==9.12.4

common shared
  default-language:   GHC2021
  default-extensions:
    BlockArguments
    DataKinds
    LambdaCase
    OverloadedLabels
    OverloadedStrings

  ghc-options:        -Wall

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    BadPlayer.Bot
    BadPlayer.YouTube

  ghc-options:     -fplugin=Polysemy.Plugin

  build-depends:
    , base             >=4.18   && <5
    , calamity         >=0.12.1 && <0.13
    , data-flags       >=0.0.3  && <0.1
    , df1              >=0.4    && <0.5
    , di               >=1.3    && <1.4
    , di-core          >=1.0.4  && <1.1
    , di-polysemy      >=0.2    && <0.3
    , modern-uri       >=0.3.6  && <0.4
    , optics           >=0.4    && <0.5
    , polysemy         >=1.9    && <2
    , polysemy-plugin  >=0.4    && <0.5
    , text             >=2.0    && <2.2
    , text-show        >=3.10   && <4
    , time             >=1.9    && <1.15

executable bad-player
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts
  build-depends:
    , bad-player
    , base        >=4.18 && <5
    , text        >=2.0  && <2.2

test-suite youtube-links
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  build-depends:
    , bad-player
    , base        >=4.18 && <5
    , text        >=2.0  && <2.2
